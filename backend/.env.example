# Server Configuration
PORT=5000
NODE_ENV=production

# URLs & Domains
CLIENT_URL=https://morph-ai.asia
TELEGRAM_WEBAPP_URL=https://morph-ai.asia
WEBHOOK_URL=https://api.morph-ai.asia

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=morphi_ai_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# AI Providers API Keys
OPENROUTER_API_KEY=your_openrouter_api_key
PIAPI_API_KEY=your_piapi_api_key
RUNWAYML_API_KEY=your_runwayml_api_key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=morphai
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Admin Panel
ADMIN_PASSWORD=your_admin_password

# Telegram Tribute Acquiring (Optional HMAC signature verification)
TRIBUTE_API_KEY=your_tribute_api_key

